<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <Revit2024Dir Condition="'$(Revit2024Dir)' == ''">C:\Program Files\Autodesk\Revit 2024</Revit2024Dir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="RevitAPI" HintPath="$(Revit2024Dir)\RevitAPI.dll" Private="false" />
    <Reference Include="RevitAPIUI" HintPath="$(Revit2024Dir)\RevitAPIUI.dll" Private="false" />
    <Reference Include="System.Runtime.Serialization" />
    <Compile Include="..\Core\*.cs" Link="Core\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
